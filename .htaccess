RewriteEngine On

# Permanently redirect legacy query-string article URLs.
RewriteCond %{THE_REQUEST} \s/+blog/post\.html\?slug=([^&\s]+) [NC]
RewriteRule ^blog/post\.html$ /blog/%1/? [R=301,L,NE,QSD]

# Keep one canonical trailing-slash form.
RewriteRule ^blog/([^/.]+)$ /blog/$1/ [R=301,L]

# Serve clean blog URLs through the CMS article template.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([^/]+)/?$ blog/post.html?slug=$1 [L,QSA]
